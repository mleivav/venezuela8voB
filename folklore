<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Día del Folklore 2026 - Venezuela</title>
    <style>
        /* Estilos generales */
        body {
            font-family: 'Montserrat', sans-serif; /* Un tipo de letra moderno y limpio */
            background-color: #f8f9fa; /* Color de fondo muy claro */
            margin: 0;
            color: #333;
        }

        /* Estilos del encabezado (Header) */
        header {
            background-color: #fff;
            padding: 20px;
            text-align: center;
            border-bottom: 3px solid #fecb2f; /* Línea amarilla en la base */
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .header-content img {
            width: 80px; /* Tamaño de la bandera */
            height: auto;
        }

        .header-content h1 {
            color: #c90016; /* Color rojo vibrante */
            font-size: 3em;
            margin: 0;
            font-weight: bold;
        }

        /* Estilos del cuerpo de la página */
        main {
            max-width: 1000px; /* Ancho máximo para que se vea bien en pantallas grandes */
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Sección "Did you know?" y "Folklore Day" */
        .intro-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Dos columnas */
            gap: 40px;
            margin-bottom: 60px;
            align-items: center; /* Centrar verticalmente */
        }

        .intro-text-column {
            background-color: #fff;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            border: 2px solid #005f9e; /* Borde azul */
        }

        .intro-text-column h2 {
            font-size: 2.2em;
            color: #005f9e;
            margin-top: 0;
        }

        .intro-text-column p {
            font-size: 1.2em;
            line-height: 1.6;
        }

        .image-column img {
            width: 100%;
            height: auto;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            display: block; /* Evita espacios vacíos debajo de la imagen */
        }

        /* Estilo para las flores decorativas */
        .flower-decorative {
            position: relative; /* Para posicionamiento absoluto de las flores */
        }
        .flower-decorative img.flower {
            position: absolute;
            width: 150px;
            z-index: 10;
        }
        .flower-top-left { top: -80px; left: -80px; }
        .flower-bottom-right { bottom: -80px; right: -80px; }

        /* Estilos para las tarjetas de información principal */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr); /* Dos columnas */
            gap: 40px;
            margin-bottom: 60px;
        }

        .info-card {
            background-color: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .info-card h3 {
            color: #c90016; /* Rojo */
            border-bottom: 2px solid #c90016;
            padding-bottom: 10px;
            margin-top: 0;
            font-size: 1.8em;
        }

        .info-card ul, .info-card ol {
            padding-left: 20px;
            font-size: 1.1em;
            line-height: 1.5;
        }

        .info-card .card-image {
            width: 100%;
            height: 200px; /* Altura fija para las imágenes */
            object-fit: cover; /* Ajustar imagen sin deformar */
            border-radius: 10px;
            margin-bottom: 20px;
            order: -1; /* Poner la imagen al principio de la tarjeta */
        }

        .card-decorator {
            position: absolute;
            background-size: contain;
            background-repeat: no-repeat;
            opacity: 0.15;
            z-index: 0;
        }

        /* Estilos para la sección de "Ubicación" */
        .location-section {
            display: grid;
            grid-template-columns: 2fr 1fr; /* Dos columnas desiguales */
            gap: 40px;
            margin-bottom: 60px;
            align-items: center;
        }

        .location-card {
            background-color: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        }

        .location-card h3 {
            color: #005f9e;
            margin-top: 0;
            font-size: 1.8em;
        }

        .location-image img {
            width: 100%;
            height: auto;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        }

        /* Estilos para la sección de "Lugares Turísticos" */
        .tourist-spots {
            margin-bottom: 60px;
        }

        .tourist-spots h3 {
            color: #c90016;
            font-size: 2.2em;
            text-align: center;
            margin-bottom: 30px;
        }

        .tourist-spots-list {
            list-style-type: disc;
            font-size: 1.3em;
            line-height: 1.6;
            columns: 2; /* Divide la lista en dos columnas */
            -webkit-columns: 2;
            -moz-columns: 2;
            column-gap: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        /* Estilos para el pie de página (Footer) */
        footer {
            background-color: #005f9e; /* Azul oscuro */
            color: #fff;
            padding: 30px;
            text-align: center;
            margin-top: 80px;
        }

        footer p {
            margin: 10px 0;
            font-size: 1.1em;
        }

        /* Decoración de flores en el pie */
        .footer-flower {
            width: 60px;
            height: 60px;
            background-size: contain;
            background-repeat: no-repeat;
            opacity: 0.6;
            display: inline-block;
            margin: 0 10px;
        }

        /* Media Queries para adaptabilidad en móviles */
        @media (max-width: 768px) {
            .header-content h1 { font-size: 2em; }
            .intro-grid { grid-template-columns: 1fr; }
            .info-grid { grid-template-columns: 1fr; }
            .location-section { grid-template-columns: 1fr; }
            .tourist-spots-list { columns: 1; -webkit-columns: 1; -moz-columns: 1; }
            .flower-decorative img.flower { width: 100px; }
            .flower-top-left { top: -50px; left: -50px; }
            .flower-bottom-right { bottom: -50px; right: -50px; }
        }
    </style>
</head>
